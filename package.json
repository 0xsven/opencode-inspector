{
  "name": "opencode-inspector",
  "version": "0.1.0",
  "private": true,
  "description": "A local, read-only inspector for OpenCode configuration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xsven/opencode-inspector.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/launch.mjs dev",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts server/usage-worker.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "node scripts/launch.mjs start",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "js-tiktoken": "^1.0.21",
    "jsonc-parser": "^3.3.1",
    "solid-js": "1.9.17",
    "solid-markdown": "2.1.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-solid": "2.11.14"
  }
}
